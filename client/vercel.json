{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://gk-ventures-api.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://gk-ventures-api.onrender.com/uploads/:path*" },
    { "source": "/(.*)", "destination": "/app.html" }
  ]
}
