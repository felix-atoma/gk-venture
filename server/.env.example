# --- Core ---
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gk_ventures?schema=public"
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER change after files are stored - existing encrypted documents would become unreadable.
FILE_ENCRYPTION_KEY=
UPLOAD_DIR=uploads
# Where uploads go: S3_BUCKET set -> that bucket; STORAGE_DRIVER=database -> Postgres (Blob table);
# otherwise the local UPLOAD_DIR.
STORAGE_DRIVER=
# Optional S3-compatible bucket (Cloudflare R2, AWS S3). When S3_BUCKET is set, uploads go there
# instead of UPLOAD_DIR - required on hosts without a persistent disk (e.g. Render free/starter).
# R2: S3_REGION=auto, S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- First admin account (used by `npm run db:seed`) ---
ADMIN_EMAIL=gilbertadawa@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Gilbert K. Kadawa

# --- Email (inquiries, receipts, signing links). Leave SMTP_HOST empty to log emails to the console. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="G|K Ventures <no-reply@kadawalegalservices.com>"
NOTIFY_EMAIL=gilbertadawa@gmail.com

# --- Paystack (https://dashboard.paystack.com -> Settings -> API Keys) ---
PAYSTACK_SECRET_KEY=

# --- Cloudflare Turnstile CAPTCHA (optional; empty = disabled) ---
TURNSTILE_SECRET_KEY=
